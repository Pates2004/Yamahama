  "Tray.Failed": "Could not initialize the tray. The window remains available. ",
  "Device.InvalidName": "The device name contains invalid characters or is too long. The connection remains active, but the entry was not saved.",
  "Startup.Heading": "Startup",
  "Settings.PowerHeading": "Power while running",
  "Startup.Windows": "Start Yamahama with Windows",
  "Startup.WindowsHint": "After confirming with OK, registers startup for the current user at Windows sign-in. Windows or Task Manager may block it. Re-enable this option and save with OK after moving the EXE.",
  "Startup.Device": "Saved device to use at startup",
  "Startup.DeviceHint": "Only previously connected and saved devices are listed. The selected entry is the shared target for automatic connection and optional power-on. Without a selected device, automatic connection is skipped. The first newly remembered, verified device becomes the target when none is selected. Choosing it does not connect or turn it on now. The selected target is saved only after OK.",
  "Startup.AutoConnect": "Automatically connect to the selected device when the application starts",
  "Startup.AutoConnectHint": "On by default. Connects on a new Yamahama launch if a saved device is selected. Connection alone sends no power command; turning the device on requires the separate option. Changing this setting does not connect now. This preference change is saved only after OK.",
  "Startup.PowerOn": "Connect and turn on the selected device when the application starts",
  "Startup.SafetyName": "Important automatic connection and power-on information",
  "Startup.Safety": "Automatic connection is on by default; it requires a selected saved device and sends no power command by itself. Without a startup target, the application waits for your selection. Windows startup, startup power-on and power-off on exit are off by default. Both startup device options use the same target. Startup power-on also provides connection, even if connection-only is unchecked. There is at most one connection attempt per launch; restoring the tray window does not repeat it. Power-on may play the previous input at its previous volume. Existing saved choices are not overwritten by new defaults.",
  "Startup.Saved": "Startup settings saved. No soundbar command was sent by this change.",
  "Startup.RegistrationFailed": "Could not read or change Windows startup registration: {0}",
  "Startup.RollbackFailed": "Configuration saving failed and the previous startup registration could not be restored. Check Windows startup settings: {0}",
  "Startup.DeviceMissing": "Cannot start the device automatically: choose an existing saved device in Settings.",
  "Startup.AlreadyOn": "Automatically connected to {0}. The device is already on; no extra power command was sent.",
  "Reset.Heading": "Restore settings",
  "Reset.Application": "Restore default settings",
  "Reset.ApplicationTitle": "Restore Yamahama settings",
  "Reset.ApplicationConfirm": "Stage the default application settings? Windows startup, startup power-on, power-off on exit, power protection and tray hiding will be off. Exit confirmation will be on. The startup target will be cleared, so automatic connection stays inactive until a device is selected. Other preferences will return to their defaults. Completed first-run setup, language, saved devices and profiles will be kept. Choose OK to save and apply the changes, or Cancel to discard them. This is not a soundbar reset.",
  "Reset.ApplicationDone": "Default application settings staged. Choose OK to save and apply them, or Cancel to discard them. Language, completed setup, devices and profiles were kept; the soundbar was not changed.",
  "Reset.Sound": "Default sound settings — limitations",
  "Reset.FactoryGuide": "Soundbar factory reset — instructions",
  "Reset.GuideLabel": "SR-C30A sound reset and factory reset",
  "Reset.GuideName": "Soundbar reset instructions and limitations",
  "Reset.FactoryOpened": "Factory reset instructions opened. The application did not send a reset command. Physical soundbar actions are required; read the warnings.",
  "Reset.SoundUnavailable": "Sound settings information opened. The factory values of all supported parameters and a separate BLE sound reset command are not verified. No change was sent.",
  "Tray.EnabledState": "On",
  "Tray.DisabledState": "Off",
  "Tray.SelectedState": "Selected",
  "Bluetooth.SavedDeviceNotAdvertising": "The saved soundbar address was not found while refreshing the Windows Bluetooth cache. Check power and range. If the device address has changed, search again and save the new entry.",
  "Profile.Heading": "Sound profiles for the connected device",
  "Profile.ReadoutName": "Saved personal sound profile",
  "Profile.Save": "Save current sound as a profile",
  "Profile.Apply": "Apply selected profile…",
  "Profile.Delete": "Delete selected profile…",
  "Profile.Hint": "Each saved device can have multiple named profiles: sound mode, Clear Voice, Bass Extension and subwoofer gain. Select a profile in the list to apply or delete it. To create another, enter a different name and save the current sound. Saving under an identical name replaces only that profile after confirmation. A legacy single profile is kept in the list. This is not a factory reset. Save reads the device; Apply requires it to be on. Power, audio source, master volume, mute and indicators are not changed. Profiles do not include DRC or installation tuning. Saving, applying and deleting a profile are independent actions, with their own confirmation where required. They do not wait for Settings OK and are not undone by Cancel.",
  "Profile.SavedDeviceRequired": "Connect to a saved SR-C30A to use profiles. For an unsaved one-time connection, use Add device first; profiles never save a device automatically.",
  "Profile.Empty": "This device has no saved sound profiles.",
  "Profile.Summary": "{0}: {1}; Clear Voice: {2}; Bass Extension: {3}; subwoofer: {4}.",
  "Profile.Title": "Sound profile",
  "Profile.OverwriteConfirm": "Replace profile “{0}” for device {1} with a fresh reading? Only this profile will be overwritten; other profiles will stay unchanged. This does not change device settings.",
  "Profile.ApplyConfirm": "Apply profile “{0}” to device {1}? This changes sound mode, Clear Voice, Bass Extension and subwoofer gain. Perceived loudness may change even though master volume is preserved. Power, source, mute and indicators are preserved. If interrupted, some settings may already have changed; no automatic rollback is performed. This is not a factory reset.",
  "Profile.DeleteConfirm": "Delete profile “{0}” for device {1}? Other profiles and the saved device will be kept, and the device’s sound settings will not change.",
  "Profile.Capturing": "Reading current sound settings to save a personal profile…",
  "Profile.Applying": "Applying the personal sound profile and verifying each change…",
  "Profile.Saved": "Personal sound profile saved from a fresh device reading. No soundbar setting was changed.",
  "Profile.Applied": "Personal sound profile applied and all changes confirmed. Power, source, master volume, mute and indicators were preserved.",
  "Profile.Deleted": "Personal sound profile deleted. The soundbar was not changed.",
  "Profile.DeviceChanged": "The connected device changed. The profile was not saved.",
  "Profile.Error.NotConnected": "The soundbar is disconnected. Profile operation stopped.",
  "Profile.Error.StaleState": "A fresh soundbar response was not received. Profile operation stopped; use Refresh before trying again.",
  "Profile.Error.InvalidState": "The soundbar returned an unsupported sound setting. Profile operation stopped.",
  "Profile.Error.Standby": "Turn on the soundbar before applying a profile. Profiles never turn it on automatically.",
  "Profile.Error.UnexpectedState": "The device did not confirm the expected settings, or a setting changed elsewhere. Profile operation stopped; some changes may already have been applied. Refresh and inspect the soundbar before trying again.",
  "Feedback.ShowOperations": "Show and announce operation messages",
  "Feedback.DisplayModeName": "Current value display",
  "Feedback.ReadOnlyFields": "Read-only fields",
  "Feedback.StaticText": "Static text",
  "Feedback.NoValues": "None",
  "Feedback.AnnounceChanges": "Announce state changes through the screen reader",
  "Feedback.Explanation": "Current value display has three choices: Read-only fields, Static text (the default) and None. None hides only duplicated parameter readouts, not essential control names and states, connection and power state, errors or warnings. Operation messages and screen-reader state announcements have independent settings. Disabling operation messages does not hide errors or warnings. Only changes confirmed by a reading are announced. A focused slider uses standard UI Automation range-value change events; the additional application announcement for that parameter is suppressed to avoid duplicate speech. Button mode retains optional application announcements. Disabling these announcements does not disable standard NVDA control feedback. Changes to these preferences in Settings take effect only after OK; first-run setup keeps its own confirmation button.",
  "Feedback.Power": "Power {0}",
  "Feedback.PowerOff": "Off",
  "Feedback.Input": "Input {0}",
  "Feedback.Volume": "Volume {0}",
  "Feedback.Mute": "Mute {0}",
  "Feedback.Subwoofer": "Subwoofer gain {0}",
  "Feedback.SoundMode": "Sound mode {0}",
  "Feedback.ClearVoice": "Clear Voice {0}",
  "Feedback.BassExtension": "Bass Extension {0}",
  "Feedback.IndicatorBrightness": "Indicator brightness {0}",
  "Levels.Volume": "Volume",
  "Levels.Subwoofer": "Subwoofer gain",
  "Levels.VolumeMode": "Device volume control method",
  "Levels.SubwooferMode": "Subwoofer gain control method",
  "Levels.Buttons": "−/+ buttons",
  "Levels.Slider": "Slider",
  "Levels.SliderHint": "Arrow keys change by 1, Page Up and Page Down by 5 for volume or 1 for subwoofer, and Home and End select the minimum or maximum. Each change immediately requests a value. The screen reader receives only the last device-confirmed value; the slider thumb may preview the request.",
  "Levels.Explanation": "Volume and subwoofer gain can independently use a slider or buttons. Sliders are the default; existing saved choices are preserved. Changing the control style sends no soundbar command. Adjustments take effect immediately, without an Apply button. A slider exposes the confirmed value to the screen reader; its requested preview is not confirmation. Subwoofer gain may require several steps, each confirmed by a reading. Refresh after an error before retrying. The control method selected in Settings takes effect only after OK; there is no preview before confirmation.",
  "Levels.SettingsSaved": "Volume and subwoofer control modes saved. Changing the view sends no soundbar commands.",
  "Levels.SubwooferPending": "Setting subwoofer gain to {0} and confirming each step…",
  "Levels.SubwooferConfirmed": "Confirmed subwoofer gain: {0}.",
  "Levels.Unconfirmed": "The device did not confirm the requested value. Some changes may already have been applied. State is stale and controls are disabled until a fresh reading; use Refresh before trying again.",
  "Tray.Summary": "Yamahama — {0}; power {1}; volume {2}; subwoofer gain {3}",
  "Tray.GroupValue": "{0}: {1}"
}
