  "Bluetooth.MissingService": "Urządzenie nie udostępnia usługi sterowania Sound Bar Remote.",
  "Bluetooth.ReadChannels": "odczytu kanałów sterowania",
  "Bluetooth.MissingChannels": "Soundbar nie udostępnia wymaganych kanałów zapisu i powiadomień.",
  "Bluetooth.EnableNotifications": "włączenia odczytu stanu",
  "Bluetooth.WrongModel": "Wykryto model {0}. Ten program obsługuje wyłącznie Yamaha SR-C30A; nie wysłano poleceń zmiany ustawień.",
  "Bluetooth.ConnectTimeout": "Soundbar nie połączył się w wyznaczonym czasie. Włącz go, zbliż do komputera i zamknij aplikację Yamahy na telefonie.",
  "Bluetooth.ChangeUnconfirmed": "Soundbar nie potwierdził żądanej zmiany. Widoczne wartości pochodzą z odczytu urządzenia, a nie z wysłanego polecenia.",
  "Bluetooth.ConfirmationLost": "Nie otrzymano potwierdzenia z soundbara. Połączenie przerwano; stan ustawienia jest niepewny.",
  "Bluetooth.CommunicationTimeout": "Upłynął czas komunikacji z soundbarem. Połącz urządzenie ponownie.",
  "Bluetooth.CommandTimeout": "Nie udało się potwierdzić polecenia. Nie zakładaj, że ustawienie zostało zmienione.",
  "Bluetooth.ResponsesLost": "Utracono odpowiedzi soundbara. Sprawdź zasilanie, zasięg Bluetooth i połącz ponownie.",
  "Bluetooth.NoControlChannel": "Brak kanału sterowania Bluetooth.",
  "Bluetooth.ChannelNotWritable": "Kanał Bluetooth nie pozwala na zapisywanie poleceń.",
  "Bluetooth.SendCommand": "wysłania polecenia",
  "Bluetooth.Disconnected": "Soundbar rozłączył połączenie Bluetooth. Włącz go lub zbliż do komputera i połącz ponownie.",
  "Bluetooth.ConnectionRequired": "Najpierw połącz się z soundbarem.",
  "Bluetooth.OperationFailed": "Nie udało się wykonać {0}. Sprawdź zasilanie, zasięg oraz uprawnienia Bluetooth. Kod Windows: {1}.",
  "Bluetooth.AdapterMissing": "Nie znaleziono adaptera Bluetooth Low Energy. Włącz zgodny adapter w systemie Windows.",
  "Bluetooth.Disabled": "Bluetooth jest wyłączony. Włącz go w ustawieniach systemu Windows.",
  "Error.InvalidOperation": "Nie można wykonać operacji w bieżącym stanie. Sprawdź połączenie, odśwież stan i spróbuj ponownie.",
  "Device.OneOffSession": "Połączenie jednorazowe: nie zmieniono listy zapisanych urządzeń.",
  "Device.AddHint": "Zapisuje aktualnie połączony i zweryfikowany soundbar. Nowe urządzenie najpierw wyszukaj i połącz.",
  "Device.RemoveHint": "Usuwa tylko wybrany lokalny wpis. Nie rozłącza sesji, nie zmienia parowania Windows ani ustawień soundbara.",
  "Settings.TextScale": "Rozmiar tekstu",
  "Settings.TextScaleChanged": "Ustawiono rozmiar tekstu: {0}%.",
  "Settings.CloseToTray": "Chowaj program do zasobnika systemowego zamiast go zamykać",
  "Settings.CloseToTrayHint": "Domyślnie wyłączone. Po zatwierdzeniu przez OK zamknięcie głównego okna, w tym X, Alt+F4 i Zamknij w menu systemowym Windows, chowa je bez kończenia programu. Tylko jawne polecenia Plik → Wyjdź oraz Wyjdź z Yamahama w menu ikony zasobnika nadal kończą program, z potwierdzeniem, jeśli jest włączone. Escape nie kończy programu.",
  "Settings.TrayChanged": "Zmieniono zachowanie zamykania głównego okna i zasobnika. Nie zmieniono ustawień soundbara.",
  "Tray.Open": "Otwórz Yamahama",
  "Tray.Exit": "Wyjdź z Yamahama",
  "Tray.NotConnected": "Brak połączenia",
  "Tray.Connected": "Połączono — stan potwierdzony",
  "Tray.StateUnknown": "Połączono — stan niepotwierdzony",
  "Tray.Busy": "Operacja w toku",
  "Tray.Modes": "Tryb dźwięku",
  "Tray.Inputs": "Źródło dźwięku",
  "Tray.Brightness": "Jasność wskaźników",
  "Tray.Volume": "Głośność",
  "Tray.Subwoofer": "Wzmocnienie subwoofera",
  "Tray.Hidden": "Okno ukryto w zasobniku. Win+B pozwala przejść do ikon; menu ikony udostępnia sterowanie, przywrócenie i zakończenie programu.",
  "Tray.Failed": "Nie udało się uruchomić zasobnika. Okno pozostaje dostępne. ",
  "Device.InvalidName": "Nazwa urządzenia zawiera nieprawidłowe znaki lub jest zbyt długa. Połączenie pozostaje aktywne, ale nie zapisano wpisu.",
  "Startup.Heading": "Uruchamianie",
  "Settings.PowerHeading": "Zasilanie podczas pracy",
  "Startup.Windows": "Uruchamiaj Yamahama z Windowsem",
  "Startup.WindowsHint": "Po zatwierdzeniu przez OK rejestruje uruchamianie dla bieżącego użytkownika przy logowaniu do Windows. Windows lub Menedżer zadań może je zablokować. Po przeniesieniu EXE ponownie włącz tę opcję i zapisz ustawienia przez OK.",
  "Startup.Device": "Zapisane urządzenie używane przy uruchamianiu",
  "Startup.DeviceHint": "Lista zawiera tylko wcześniej połączone i zapisane urządzenia. Wybrany wpis jest wspólnym celem automatycznego połączenia i opcjonalnego włączenia. Bez wybranego urządzenia automatyczne połączenie jest pomijane. Pierwsze nowo zapamiętane, zweryfikowane urządzenie zostanie wybrane, jeśli nie ma celu. Wybór nie łączy ani nie włącza urządzenia teraz. Wybór celu zostanie zapisany dopiero po OK.",
  "Startup.AutoConnect": "Automatycznie połącz z wybranym urządzeniem przy starcie aplikacji",
  "Startup.AutoConnectHint": "Domyślnie włączone. Łączy przy nowym uruchomieniu Yamahama, jeśli wybrano zapamiętane urządzenie. Samo połączenie nie wysyła polecenia zasilania; włączenie wymaga osobnej opcji. Zmiana ustawienia nie łączy teraz. Zmiana tej preferencji jest zapisywana dopiero po OK.",
  "Startup.PowerOn": "Połącz i włącz wybrane urządzenie przy starcie aplikacji",
  "Startup.SafetyName": "Ważne informacje o automatycznym połączeniu i włączaniu",
  "Startup.Safety": "Automatyczne łączenie jest domyślnie włączone; wymaga wybranego zapamiętanego urządzenia i samo nie wysyła polecenia zasilania. Bez urządzenia startowego aplikacja czeka na wybór. Uruchamianie z Windowsem, włączanie soundbara przy starcie i wyłączanie przy zamknięciu są domyślnie wyłączone. Obie opcje startowe korzystają z tego samego soundbara. Włączanie przy starcie zapewnia też połączenie, nawet gdy samo automatyczne łączenie odznaczono. Przy każdym starcie wykonywana jest najwyżej jedna próba połączenia. Przywrócenie okna z zasobnika nie powtarza operacji. Włączenie może odtworzyć poprzednie wejście przy poprzedniej głośności. Istniejące zapisane wybory nie są nadpisywane nowymi wartościami domyślnymi.",
  "Startup.Saved": "Zapisano ustawienia uruchamiania. Zmiana nie wysyła teraz polecenia do soundbara.",
  "Startup.RegistrationFailed": "Nie udało się odczytać lub zmienić autostartu Windows: {0}",
  "Startup.RollbackFailed": "Zapis konfiguracji nie powiódł się i nie udało się odtworzyć poprzedniego autostartu. Sprawdź ustawienia Windows: {0}",
  "Startup.DeviceMissing": "Nie można automatycznie uruchomić urządzenia: wybierz istniejący zapisany wpis w Ustawieniach.",
  "Startup.AlreadyOn": "Połączono automatycznie z {0}. Urządzenie jest już włączone; nie wysłano dodatkowego polecenia zasilania.",
  "Reset.Heading": "Przywracanie ustawień",
  "Reset.Application": "Przywróć domyślne ustawienia",
  "Reset.ApplicationTitle": "Przywracanie ustawień Yamahama",
  "Reset.ApplicationConfirm": "Przygotować domyślne ustawienia aplikacji? Autostart Windows, włączanie soundbara przy starcie, wyłączanie przy zakończeniu, ochrona zasilania i chowanie do zasobnika będą wyłączone. Potwierdzanie zakończenia będzie włączone. Cel startowy zostanie wyczyszczony, więc autołączenie pozostanie nieaktywne bez wyboru urządzenia. Pozostałe preferencje wrócą do wartości domyślnych. Zakończona pierwsza konfiguracja, język, zapisane urządzenia i profile zostaną zachowane. Wybierz OK, aby zapisać i zastosować zmiany, albo Anuluj, aby je odrzucić. Nie jest to reset soundbara.",
  "Reset.ApplicationDone": "Przygotowano domyślne ustawienia aplikacji. Wybierz OK, aby je zapisać i zastosować, albo Anuluj, aby je odrzucić. Zachowano język, zakończoną konfigurację, urządzenia i profile; soundbar nie został zmieniony.",
  "Reset.Sound": "Domyślne ustawienia dźwięku — ograniczenia",
  "Reset.FactoryGuide": "Reset fabryczny soundbara — instrukcja",
  "Reset.GuideLabel": "Reset dźwięku i reset fabryczny SR-C30A",
  "Reset.GuideName": "Instrukcja i ograniczenia resetowania soundbara",
  "Reset.FactoryOpened": "Otwarto instrukcję resetu fabrycznego. Program nie wysłał polecenia resetu. Wymagane są czynności na soundbarze; przeczytaj ostrzeżenia.",
  "Reset.SoundUnavailable": "Otwarto informacje o ustawieniach dźwięku. Nie ma zweryfikowanych wartości fabrycznych wszystkich obsługiwanych parametrów ani osobnej komendy resetu dźwięku BLE. Nie wysłano żadnej zmiany.",
  "Tray.EnabledState": "Włączone",
  "Tray.DisabledState": "Wyłączone",
  "Tray.SelectedState": "Wybrane",
  "Bluetooth.SavedDeviceNotAdvertising": "Nie odnaleziono zapisanego adresu soundbara podczas odświeżania pamięci Bluetooth Windows. Sprawdź zasilanie i zasięg. Jeśli adres urządzenia się zmienił, wyszukaj je ponownie i zapisz nowy wpis.",
  "Profile.Heading": "Profile dźwięku połączonego urządzenia",
  "Profile.ReadoutName": "Zapisany własny profil dźwięku",
  "Profile.Save": "Zapisz bieżący dźwięk jako profil",
  "Profile.Apply": "Zastosuj wybrany profil…",
  "Profile.Delete": "Usuń wybrany profil…",
  "Profile.Hint": "Każde zapisane urządzenie może mieć wiele nazwanych profili: tryb dźwięku, wyraźny głos, wzmocnienie basu i wzmocnienie subwoofera. Wybierz profil na liście, aby go zastosować lub usunąć. Aby utworzyć nowy, wpisz inną nazwę i zapisz bieżący dźwięk. Zapis pod identyczną nazwą zastępuje tylko ten profil po potwierdzeniu. Starszy pojedynczy profil jest zachowywany na liście. To nie jest reset fabryczny. Zapis odczytuje urządzenie, a zastosowanie wymaga jego włączenia. Zasilanie, źródło, głośność główna, wyciszenie i wskaźniki nie są zmieniane. Profile nie obejmują DRC ani korekcji montażu. Zapis, zastosowanie i usunięcie profilu to niezależne działania, z własnym potwierdzeniem tam, gdzie jest wymagane. Nie czekają na OK w Ustawieniach, a Anuluj ich nie cofa.",
  "Profile.SavedDeviceRequired": "Połącz się z zapisanym SR-C30A, aby używać profili. Przy niezapisanym połączeniu jednorazowym najpierw wybierz Dodaj urządzenie. Profil nigdy nie zapisuje urządzenia automatycznie.",
  "Profile.Empty": "To urządzenie nie ma zapisanych profili dźwięku.",
  "Profile.Summary": "{0}: {1}; wyraźny głos: {2}; wzmocnienie basu: {3}; subwoofer: {4}.",
  "Profile.Title": "Profil dźwięku",
  "Profile.OverwriteConfirm": "Zastąpić profil „{0}” urządzenia {1} świeżym odczytem? Tylko ten profil zostanie nadpisany; pozostałe profile pozostaną bez zmian. To nie zmienia ustawień urządzenia.",
  "Profile.ApplyConfirm": "Zastosować profil „{0}” do urządzenia {1}? Zmienią się tryb dźwięku, wyraźny głos, wzmocnienie basu i wzmocnienie subwoofera. Odczuwalna głośność może się zmienić mimo zachowania głośności głównej. Zasilanie, źródło, wyciszenie i wskaźniki zostaną zachowane. Przerwanie może pozostawić część zmian — nie są automatycznie cofane. To nie jest reset fabryczny.",
  "Profile.DeleteConfirm": "Usunąć profil „{0}” urządzenia {1}? Pozostałe profile i zapisane urządzenie zostaną zachowane, a ustawienia dźwięku urządzenia nie zmienią się.",
  "Profile.Capturing": "Odczytuję bieżące ustawienia dźwięku do zapisania profilu…",
  "Profile.Applying": "Stosuję własny profil dźwięku i sprawdzam każdą zmianę…",
  "Profile.Saved": "Własny profil zapisany ze świeżego odczytu urządzenia. Nie zmieniono ustawień soundbara.",
  "Profile.Applied": "Własny profil dźwięku zastosowany i potwierdzony. Zasilanie, źródło, głośność główna, wyciszenie i wskaźniki zachowane.",
  "Profile.Deleted": "Własny profil dźwięku usunięty. Nie zmieniono soundbara.",
  "Profile.DeviceChanged": "Połączone urządzenie zmieniło się. Profil nie został zapisany.",
  "Profile.Error.NotConnected": "Soundbar jest rozłączony. Operacja profilu została zatrzymana.",
  "Profile.Error.StaleState": "Nie otrzymano świeżej odpowiedzi soundbara. Operacja profilu zatrzymana — użyj Odśwież przed ponowną próbą.",
  "Profile.Error.InvalidState": "Soundbar zwrócił nieobsługiwane ustawienie dźwięku. Operacja profilu została zatrzymana.",
  "Profile.Error.Standby": "Włącz soundbar przed zastosowaniem profilu. Profil nigdy nie włącza go automatycznie.",
  "Profile.Error.UnexpectedState": "Urządzenie nie potwierdziło oczekiwanych ustawień lub zmieniono je poza aplikacją. Operacja zatrzymana; część zmian mogła już zostać zastosowana. Odśwież i sprawdź stan przed kolejną próbą.",
  "Feedback.ShowOperations": "Pokazuj i odczytuj komunikaty operacji",
  "Feedback.DisplayModeName": "Wyświetlanie bieżących wartości",
  "Feedback.ReadOnlyFields": "Pola tylko do odczytu",
  "Feedback.StaticText": "Statyczny tekst",
  "Feedback.NoValues": "Brak",
  "Feedback.AnnounceChanges": "Zgłaszaj zmiany stanu przez czytnik ekranu",
  "Feedback.Explanation": "Wyświetlanie bieżących wartości ma trzy opcje: Pola tylko do odczytu, Statyczny tekst (domyślnie) i Brak. Brak ukrywa wyłącznie powielone odczyty parametrów, nie niezbędne nazwy i stany kontrolek, stan połączenia i zasilania, błędy ani ostrzeżenia. Komunikaty operacji i zgłaszanie zmian przez czytnik mają niezależne ustawienia. Wyłączenie komunikatów operacji nie ukrywa błędów ani ostrzeżeń. Zgłaszane są wyłącznie zmiany potwierdzone odczytem. Suwak z fokusem korzysta ze standardowych zdarzeń zmiany wartości zakresu UI Automation; dodatkowe powiadomienie aplikacji dla tego samego parametru jest pomijane, aby nie dublować odczytu. Tryb przycisków zachowuje opcjonalne powiadomienia aplikacji. Wyłączenie tych powiadomień nie wyłącza standardowego odczytywania kontrolek przez NVDA. Zmiany tych preferencji w Ustawieniach obowiązują dopiero po OK; pierwsza konfiguracja nadal ma własny przycisk zatwierdzenia.",
  "Feedback.Power": "Zasilanie {0}",
  "Feedback.PowerOff": "Wyłączone",
  "Feedback.Input": "Wejście {0}",
  "Feedback.Volume": "Głośność {0}",
  "Feedback.Mute": "Wyciszenie {0}",
  "Feedback.Subwoofer": "Wzmocnienie subwoofera {0}",
  "Feedback.SoundMode": "Tryb dźwięku {0}",
  "Feedback.ClearVoice": "Wyraźny głos {0}",
  "Feedback.BassExtension": "Wzmocnienie basu {0}",
  "Feedback.IndicatorBrightness": "Jasność wskaźników {0}",
  "Levels.Volume": "Głośność",
  "Levels.Subwoofer": "Wzmocnienie subwoofera",
  "Levels.VolumeMode": "Sposób sterowania głośnością urządzenia",
  "Levels.SubwooferMode": "Sposób sterowania wzmocnieniem subwoofera",
  "Levels.Buttons": "Przyciski −/+",
  "Levels.Slider": "Suwak",
  "Levels.SliderHint": "Strzałki zmieniają wartość o 1, Page Up i Page Down o 5 dla głośności lub o 1 dla subwoofera, a Home i End wybierają minimum lub maksimum. Każda zmiana od razu żąda nowej wartości. Czytnik otrzymuje tylko ostatnią wartość potwierdzoną przez urządzenie; uchwyt suwaka może pokazywać podgląd żądania.",
  "Levels.Explanation": "Głośność i wzmocnienie subwoofera mogą niezależnie używać suwaka albo przycisków. Domyślnie wybrane są suwaki; istniejące zapisane wybory pozostają bez zmian. Zmiana sposobu sterowania nie wysyła polecenia do soundbara. Regulacja działa od razu, bez przycisku Zastosuj. Suwak udostępnia czytnikowi potwierdzoną wartość; podgląd żądanej pozycji nie jest potwierdzeniem. Wzmocnienie subwoofera może wymagać kilku kroków, każdy z odczytem potwierdzenia. Po błędzie odśwież stan przed ponowną próbą. Wybór sposobu sterowania w Ustawieniach obowiązuje dopiero po OK; nie ma podglądu przed zatwierdzeniem.",
  "Levels.SettingsSaved": "Zapisano sposób sterowania głośnością i subwooferem. Zmiana widoku nie wysyła poleceń do soundbara.",
  "Levels.SubwooferPending": "Ustawianie wzmocnienia subwoofera na {0} i potwierdzanie każdego kroku…",
  "Levels.SubwooferConfirmed": "Potwierdzone wzmocnienie subwoofera: {0}.",
  "Levels.Unconfirmed": "Urządzenie nie potwierdziło żądanej wartości. Część zmian mogła już zostać wykonana. Stan jest nieaktualny, a sterowanie zablokowane do świeżego odczytu; użyj Odśwież przed kolejną próbą.",
  "Tray.Summary": "Yamahama — {0}; zasilanie {1}; głośność {2}; wzmocnienie subwoofera {3}",
  "Tray.GroupValue": "{0}: {1}"
}
