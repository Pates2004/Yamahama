<Window x:Class="YamahaRemote.Windows.SectionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:YamahaRemote.Windows"
        Width="840" Height="760" MinWidth="520" MinHeight="400"
        ShowInTaskbar="False" WindowStartupLocation="CenterOwner"
        FontFamily="{DynamicResource {x:Static SystemFonts.MessageFontFamilyKey}}"
        KeyboardNavigation.TabNavigation="Cycle" KeyDown="OnSectionKeyDown">
    <DockPanel Margin="12">
        <StackPanel DockPanel.Dock="Bottom">
            <TextBox x:Name="SectionStatusMessage" Style="{StaticResource ReadoutStyle}" TextWrapping="Wrap"
                     MinHeight="45" MaxHeight="100" VerticalScrollBarVisibility="Auto" Visibility="Collapsed"
                     AutomationProperties.LiveSetting="Off" local:UsageHints.Text="{DynamicResource Status.Hint}" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="SettingsOkButton" Content="{DynamicResource Settings.OK}" Visibility="Collapsed"
                        AutomationProperties.Name="{DynamicResource Settings.OK}" Click="OnAcceptSettings" />
                <Button x:Name="SettingsCancelButton" Content="{DynamicResource Settings.Cancel}" Visibility="Collapsed"
                        AutomationProperties.Name="{DynamicResource Settings.Cancel}" Click="OnCloseSection" />
            <Button x:Name="SectionCloseButton" Content="{DynamicResource Window.Close}" HorizontalAlignment="Right"
                    AutomationProperties.Name="{DynamicResource Window.CloseName}" Click="OnCloseSection" />
            </StackPanel>
        </StackPanel>
        <ContentControl x:Name="SectionContent" Focusable="False" />
    </DockPanel>
</Window>
